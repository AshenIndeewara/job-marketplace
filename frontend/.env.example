# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laravel API base URL (versioned, no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Sanctum CSRF/session origin handling
NEXT_PUBLIC_API_CSRF_URL=http://localhost:8000/sanctum/csrf-cookie

# Site locale defaults (en | si | ta)
NEXT_PUBLIC_DEFAULT_LOCALE=en
